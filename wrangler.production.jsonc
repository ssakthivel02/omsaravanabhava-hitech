{
  // PRODUCTION Worker for the new hi-tech application. Distinct from the
  // isolated preview Worker (`omsaravanabhava-hitech-preview`) and from every
  // legacy Worker/Pages project.
  //
  // DELIBERATELY NO routes, custom_domain, zone or omsaravanabhava.org binding.
  // Attaching the root domain is a separate, owner-executed cutover step (see
  // docs/RELEASE_CUTOVER_ROLLBACK_RUNBOOK_V1.md section 5, step 9, and
  // docs/PRODUCTION_RELEASE_MECHANISM_V1.md). Until then this Worker is only
  // reachable at its workers.dev URL for smoke testing.
  "name": "omsaravanabhava-hitech",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
